{
  "size": 0,
  "query": {
    "range": {
      "publish_date": {
        "gte": "<date_from>",
        "lt": "<date_to>"
      }
    }
  },
  "aggs": {
    "daily_avg": {
      "date_histogram": {
        "field": "publish_date",
        "calendar_interval": "1d"
      },
      "aggs": {
        "price": {
          "avg": {
            "field": "product_price"
          }
        }
      }
    }
  }
}
